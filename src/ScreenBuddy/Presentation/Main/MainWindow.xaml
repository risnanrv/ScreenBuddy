<Window x:Class="ScreenBuddy.Presentation.Main.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:common="clr-namespace:ScreenBuddy.Presentation.Common"
        Title="ScreenBuddy"
        Width="460" Height="540"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Icon="../../Resources/Icon/app.ico">

    <Border Background="{StaticResource color-base-850}"
            CornerRadius="{StaticResource RadiusLarge}"
            BorderBrush="{StaticResource color-border-subtle}"
            BorderThickness="1"
            Margin="8"
            Padding="32,24,32,24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Header -->
                <RowDefinition Height="*" />    <!-- Dynamic Body -->
                <RowDefinition Height="Auto" /> <!-- Footer Actions -->
            </Grid.RowDefinitions>

            <!-- Top Title Bar / Header -->
            <Grid Grid.Row="0" Margin="0,0,0,24">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="◯ "
                               Foreground="{StaticResource color-text-primary}"
                               FontSize="16"
                               FontWeight="Bold" />
                    <TextBlock Text="ScreenBuddy"
                               Foreground="{StaticResource color-text-primary}"
                               FontSize="{StaticResource FontSizeHeading}"
                               FontWeight="SemiBold"
                               FontFamily="{StaticResource FontFamilyPrimary}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="⚙"
                            Command="{Binding OpenSettingsCommand}"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{StaticResource color-text-secondary}"
                            FontSize="18"
                            Cursor="Hand"
                            Margin="0,0,12,0"
                            ToolTip="Settings" />

                    <Button Content="✕"
                            Command="{Binding NotNowCommand}"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{StaticResource color-text-secondary}"
                            FontSize="18"
                            Cursor="Hand"
                            ToolTip="Close to Tray" />
                </StackPanel>
            </Grid>

            <!-- Dynamic Body by State -->
            <Grid Grid.Row="1">
                <!-- 1. STATE A: STOPPED / READY -->
                <StackPanel Visibility="{Binding IsStateStopped, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{Binding StatusSubtitle}"
                               Foreground="{StaticResource color-text-secondary}"
                               FontSize="{StaticResource FontSizeBody}"
                               FontFamily="{StaticResource FontFamilyPrimary}"
                               TextWrapping="Wrap"
                               LineHeight="22"
                               Margin="0,0,0,28" />

                    <!-- Work Duration -->
                    <StackPanel Margin="0,0,0,20">
                        <TextBlock Text="Work duration"
                                   Foreground="{StaticResource color-text-primary}"
                                   FontSize="{StaticResource FontSizeBody}"
                                   FontWeight="Medium"
                                   FontFamily="{StaticResource FontFamilyPrimary}" />
                        <TextBlock Text="Minutes of focus before a break"
                                   Foreground="{StaticResource color-text-secondary}"
                                   FontSize="{StaticResource FontSizeCaption}"
                                   FontFamily="{StaticResource FontFamilyPrimary}"
                                   Margin="0,2,0,8" />
                        <common:NumericInputBox Value="{Binding WorkDurationMinutes, Mode=TwoWay}"
                                               MinValue="1" MaxValue="120"
                                               Suffix="minutes" />
                    </StackPanel>

                    <!-- Break Duration -->
                    <StackPanel Margin="0,0,0,20">
                        <TextBlock Text="Break duration"
                                   Foreground="{StaticResource color-text-primary}"
                                   FontSize="{StaticResource FontSizeBody}"
                                   FontWeight="Medium"
                                   FontFamily="{StaticResource FontFamilyPrimary}" />
                        <TextBlock Text="Minutes to rest between sessions"
                                   Foreground="{StaticResource color-text-secondary}"
                                   FontSize="{StaticResource FontSizeCaption}"
                                   FontFamily="{StaticResource FontFamilyPrimary}"
                                   Margin="0,2,0,8" />
                        <common:NumericInputBox Value="{Binding BreakDurationMinutes, Mode=TwoWay}"
                                               MinValue="1" MaxValue="60"
                                               Suffix="minutes" />
                    </StackPanel>
                </StackPanel>

                <!-- 2. ACTIVE COUNTDOWN STATES: WORKING / PAUSED / BREAK / SNOOZED -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsStateStopped}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <TextBlock Text="{Binding StatusHeader}"
                               Foreground="{StaticResource color-text-secondary}"
                               FontSize="{StaticResource FontSizeHeading}"
                               FontWeight="Medium"
                               FontFamily="{StaticResource FontFamilyPrimary}"
                               TextAlignment="Center"
                               Margin="0,0,0,8" />

                    <TextBlock Text="{Binding CountdownText}"
                               Foreground="{StaticResource color-text-primary}"
                               FontSize="64"
                               FontWeight="Light"
                               FontFamily="{StaticResource FontFamilyPrimary}"
                               TextAlignment="Center"
                               Margin="0,0,0,16" />

                    <TextBlock Text="{Binding StatusSubtitle}"
                               Foreground="{StaticResource color-text-tertiary}"
                               FontSize="{StaticResource FontSizeCaption}"
                               FontFamily="{StaticResource FontFamilyPrimary}"
                               TextAlignment="Center"
                               Margin="0,0,0,24" />
                </StackPanel>
            </Grid>

            <!-- Bottom Actions -->
            <Grid Grid.Row="2" Margin="0,16,0,0">
                <!-- State A Actions -->
                <Grid Visibility="{Binding IsStateStopped, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Content="Not Now"
                            Style="{StaticResource GhostButtonStyle}"
                            Command="{Binding NotNowCommand}" />

                    <Button Grid.Column="2"
                            Content="Start Session"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding StartSessionCommand}" />
                </Grid>

                <!-- Working State Actions -->
                <Grid Visibility="{Binding IsStateWorking, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Content="Pause"
                            Style="{StaticResource GhostButtonStyle}"
                            Command="{Binding PauseSessionCommand}" />

                    <Button Grid.Column="2"
                            Content="Stop Session"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding StopSessionCommand}" />
                </Grid>

                <!-- Paused State Actions -->
                <Grid Visibility="{Binding IsStatePaused, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Content="Resume"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding ResumeSessionCommand}" />

                    <Button Grid.Column="2"
                            Content="Stop Session"
                            Style="{StaticResource GhostButtonStyle}"
                            Command="{Binding StopSessionCommand}" />
                </Grid>

                <!-- Break State Actions -->
                <Grid Visibility="{Binding IsStateBreak, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Content="Skip Break"
                            Style="{StaticResource GhostButtonStyle}"
                            Command="{Binding SkipBreakCommand}" />

                    <Button Grid.Column="2"
                            Content="Snooze 5m"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding SnoozeBreakCommand}"
                            CommandParameter="5" />
                </Grid>

                <!-- Snoozed State Actions -->
                <Grid Visibility="{Binding IsStateSnoozed, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Content="Resume Work"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding ResumeSessionCommand}" />

                    <Button Grid.Column="2"
                            Content="Stop Session"
                            Style="{StaticResource GhostButtonStyle}"
                            Command="{Binding StopSessionCommand}" />
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
